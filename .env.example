# ============================================================
# StockBotFree — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Alpaca Paper Trading ---
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Alpaca MCP Server ---
# Command to launch the Alpaca MCP server (Python package via uvx)
ALPACA_MCP_SERVER_CMD=uvx alpaca-mcp-server
# Transport: "stdio" (local) or "sse" (remote)
ALPACA_MCP_TRANSPORT=stdio

# --- LLM Provider ---
# Options: "openai", "anthropic", "ollama", "local"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here
# For Ollama / local models:
LLM_BASE_URL=http://localhost:11434

# --- Risk Limits ---
DAILY_LOSS_LIMIT=-100.0
MAX_POSITION_SIZE_PCT=5.0
MAX_OPEN_ORDERS=10
SYMBOL_ALLOWLIST=AAPL,MSFT,TSLA,SPY,QQQ,NVDA,AMD,AMZN,GOOG,META

# --- App Settings ---
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.jsonl
TRADING_MODE=paper                   # paper | live
MARKET_HOURS_ONLY=false              # true = block trades outside NYSE 09:30-16:00 ET
LIVE_MODE_CONFIRM=                   # Must be "I_UNDERSTAND_LIVE_TRADING" for live mode

# --- API Security ---
API_KEY=                             # Set a strong key to require auth on all endpoints
API_KEY_HEADER=X-API-Key             # Header name for API key
AUTH_ENABLED=true                    # false = disable auth (dev/local only)

# --- Autonomous Trading Mode ---
# WARNING: Enables AI-driven trading without manual confirmation.
AUTONOMOUS_MODE_ENABLED=false        # true = enable autonomous trading loop
AUTONOMOUS_MODE_CONFIRM=             # Must be "I_UNDERSTAND_AUTONOMOUS_TRADING" to enable
AUTONOMOUS_SCAN_INTERVAL_SECONDS=300 # How often (seconds) the agent scans for signals
AUTONOMOUS_MAX_POSITIONS=3           # Max simultaneous open positions
AUTONOMOUS_RISK_BUDGET=-50.0         # $ risk budget before autonomous mode self-stops
AUTONOMOUS_SYMBOLS=SPY,QQQ           # Comma-separated symbols to monitor
AUTONOMOUS_STRATEGY=technical        # Strategy name: technical, momentum, mean_reversion
AUTONOMOUS_MIN_CONFIDENCE=0.65       # Minimum LLM confidence to act (0.0-1.0)
